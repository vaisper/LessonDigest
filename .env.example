# Скопируй в .env и заполни. Файл .env не коммитить.
#
# Где взять ключи GigaChat:
# 1. https://developers.sber.ru/studio  (аккаунт Sber ID; для физлиц старт бесплатный)
# 2. раздел GigaChat API -> создать проект
# 3. в проекте -> "Авторизационные данные"
# 4. Client ID -> GIGACHAT_CLIENT_ID, Client Secret -> GIGACHAT_CLIENT_SECRET

GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Если в кабинете Сбера выдан ОДИН ключ (Authorization key, base64) —
# впишите его сюда, а CLIENT_ID/SECRET можно не заполнять.
# GIGACHAT_AUTH_KEY=

# optional fallback
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=

# later
# TELEGRAM_BOT_TOKEN=
