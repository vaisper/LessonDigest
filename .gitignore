.env
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# реальные уроки — не в git
audio/raw/*
audio/incoming/*
audio/normalized/*
transcripts/*
digests/*
runs/*
!audio/raw/.gitkeep
!audio/incoming/.gitkeep
!audio/normalized/.gitkeep
!transcripts/.gitkeep
!digests/.gitkeep
!digests/_eval/.gitkeep
!runs/.gitkeep

# модели whisper могут качаться локально
models/
*.bin
*.pt

# сгенерированные озвучки уроков большие (WAV ~25 МБ) — в git только тексты
samples/generated/*.wav
